#include <stdio.h>
int main(){
    int a[5],i,temp,max,min;
    printf("Enter Array Elements:\n");
    for(i=0;i<5;i++){
        scanf("%d",&a[i]);
    }
    max=a[0];
    min=a[0];
    for(i=0;i<5;i++){
            if(a[i]>max){
                max=a[i];}
        }
    for(i=0;i<5;i++){
            if(a[i]<min){
                min=a[i];}
        }
printf("Max Value %d\n",max);
printf("Min Value %d",min);
return 0;
}
