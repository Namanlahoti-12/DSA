#include<stdio.h>
void SelectionSort(int a[]){
int i,j,temp, min=0;
for(i=0;i<9;i++){
    min=i;
    for(j=i+1;j<10;j++){
    if(a[j]<a[min])
        min=j;
        }
    if(min!=i){
    temp=a[min];
    a[min]=a[i];
    a[i]=temp;
        }
    }
}
int main(){
printf("Enter Array elements:");
int a[10];
for(int i=0;i<10;i++)
    scanf("%d",&a[i]);
SelectionSort(a);
for(int i=0;i<10;i++)
    printf("%d\t",a[i]);
return 0;
}
