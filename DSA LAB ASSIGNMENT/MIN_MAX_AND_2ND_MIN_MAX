#include <stdio.h>
int main(){
    int a[5],i,temp,max,min;
    printf("Enter Array Elements:\n");
    for(i=0;i<5;i++){
        scanf("%d",&a[i]);
    }
    //MIN MAX CODE
    max=a[0];
    min=a[0];
    for(i=0;i<5;i++){
            if(a[i]>max){
                max=a[i];}
        }
    for(i=0;i<5;i++){
            if(a[i]<min){
                min=a[i];}
        }
printf("Max Value %d\n",max);
printf("Min Value %d\n",min);
//SWAPPING MIN AND MAX VALUES WITH LAST 2 INDEX
int end,end2;
for(int i=0;i<5;i++){
    if(max==a[i]){
        end=a[i];
        a[i]=a[4];
        a[4]=end;}
    if(min==a[i]){
        end2=a[i];
        a[i]=a[3];
        a[3]=end2;
    }
}
//2ND MAX AND 2ND MIN VALUE
int max2=a[0],min2=a[0];
for(i=0;i<3;i++){
            if(a[i]>max2){
                max2=a[i];}
        }
    for(i=0;i<3;i++){
            if(a[i]<min2){
                min2=a[i];}
        }
printf("2nd Max Value %d\n",max2);
printf("2nd Min Value %d",min2);

return 0;
}
