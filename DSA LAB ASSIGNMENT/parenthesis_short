#include <stdio.h>
#include <string.h>
struct stack{
char arr[20];
int top;
};
struct stack s;
int isempty(){
    if(s.top==-1){
        return 1;}
    else
        return 0;
    }
int isfull(){
    if(s.top==9){
        return 1;}
    else
        return 0;
    }


int push(char a){
    if(isfull()==1){
        printf("Stack is full!!");
    }
    else{
        s.top++;
        s.arr[s.top]=a;
    }
    }
int pop(){
    if(isempty()==1){
        printf("Stack is empty!!");
    }
    else{
        s.top--;
    }}
int length(char str[]){
    int i=0,size=0;
    while(str[i]!='\0'){
        i++;
        size++;
    }
    return size;
}
int main(){
    s.top=-1;
    char str[20];
    printf("Enter String: ");
    scanf("%s",str);
    int i=0;
    while(str[i]!='\0'){
        if(str[i]=='(' ||str[i]=='{'||str[i]=='['){
            push(str[i]);}
        else{
            if(str[i]==')' && s.arr[s.top]!='('){
                printf("not balanced");
                return 0;}
            if(str[i]==']' && s.arr[s.top]!='['){
                printf("not balanced");
                return 0;}
            if(str[i]=='}' && s.arr[s.top]!='{'){
                printf("not balanced");
                return 0;}
                pop();
                }i++;}
        if(s.top!=0)
            printf("Balanced");
        else
            printf("unbalanced");

return 0;}
