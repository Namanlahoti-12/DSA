#include <stdio.h>
struct student{
    char name[25];
    char roll_no[10];
    char address[100];
};
int main(){
    struct student s[3];
    for(int i=0;i<3;i++){
        printf("ANSWER IN THE FOLLOWING ORDER: \nNAME: \nROLL NO. :\nADDRESS :\n");
        printf("Student %d\n",i+1);
        scanf("%s",&s[i].name);
        scanf("%s",&s[i].roll_no);
        scanf("%s",&s[i].address);}
    for(int i=0;i<3;i++){
        printf("Student %d\n",i+1);
        printf("%s\n",s[i].name);
        printf("%s\n",s[i].roll_no);
        printf("%s\n",s[i].address);}
    
    return 0;
    
    
}
