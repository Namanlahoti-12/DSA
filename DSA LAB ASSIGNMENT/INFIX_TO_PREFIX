#include<stdio.h>
#include<ctype.h>
struct stack{
    int top;
    int arr[20];
};
struct stack s;
void push(int a){
    if(s.top==19)
        printf("STACK IS FULL!!");
    else
    s.arr[++s.top]=a;
    }
void pop(){
    if(s.top==-1)
        printf("STACK IS EMPTY!!");
    else
        s.top--;
}
int priority(int a){
    if(a==')')
        return 0;
    else if(a=='-' || a=='+')
        return 1;
    else if(a=='/' || a=='*')
        return 2;
    else if(a=='^' || a=='$')
        return 3;
    }
int len(char exp[]){
    int i=0,size=0;
    while(exp[i]!='\0'){
        i++;
        size++;}
    return size;
}
int main(){
    s.top=-1;
    char exp[20];
    printf("Enter Expression: ");
    scanf("%s",exp);
    char rev[20];
    char ans[20];
    int l=len(exp);
    int j=0;
    for(int i=l-1;i>=0;i--){
        rev[j]=exp[i];
        j++;
    }
    int k=0;
    int i=0;
    while(rev[i]!='\0'){
        if(rev[i]==')')
            push(rev[i]);
        else if(isalnum(rev[i]))
            ans[k++]=rev[i];
        else if(rev[i]=='('){
            while(s.top!=-1 && s.arr[s.top]!=')'){
                 ans[k++]=s.arr[s.top];
                pop();
                    }
                if(s.top!=-1)
                    pop();}
        else{
            while(s.top!=-1 && priority(rev[i])<priority(s.arr[s.top])){
                 ans[k++]=s.arr[s.top];
                pop();
            }
            push(rev[i]);
        }
        i++;
            }
    ans[k++]=s.arr[s.top];
    pop();
    int l2=len(ans);
    for(int i=l2;i>=0;i--){
        printf("%c",ans[i]);
    }
    return 0;}
