#include <stdio.h>
struct queue{
    int arr[5];
    int rear;
    int front;
};
struct queue q;
int isfull(){
    if((q.rear==4 && q.front==0) || (q.front==q.rear+1))
        return 1;
    else
        return 0;}
int isempty(){
    if(q.front==-1)
        return 1;
    else
        return 0;
    }
int enqueue(int a){
    if (isfull()==1)
        printf("Queue is full!!\n");
    else if(isempty()==1){
        q.rear=0;
        q.front=0;
        q.arr[q.rear]=a;
    }
    else{
            if(q.rear==4){
                q.rear=-1;}
            q.rear++;
            q.arr[q.rear]=a;
            }
    }
void dequeue(){
    if(isempty()==1)
        printf("Queue is empty!!");
    else if(q.rear==q.front){
        int x =q.arr[q.front];
        printf("Dequeued element is %d\n",x);
        q.rear=-1;
        q.front=-1;
        }
    else{
        int x =q.arr[q.front];
            if(q.front==4){
                q.front=-1;}
            q.front++;
            printf("Dequeued element is %d\n",x);}
}
int peek(){
    if(isempty()==1)
        printf("Queue is empty!!\n");
    else
        printf("%d\n",q.arr[q.front]);}
int traverse(){
    if (isempty()==1)
        printf("Queue is empty!!\n");
    else{
        if(q.front<=q.rear)
            for(int i=q.front;i<=q.rear;i++){
                printf("%d \n",q.arr[i]);}
        else {
            for(int i=q.front;i<=4;i++){
                printf("%d \n",q.arr[i]);}
            for(int i=0;i<=q.rear;i++){
                printf("%d \n",q.arr[i]);
            }}}}
int main(){
    q.front=-1;
    q.rear=-1;
    int a,b;
    int flag=0;
    while(flag!=1){
        printf("Which Operation do you want to apply on Queue? \n 1. Enqueue \n 2. Dequeue \n 3. Peek \n 4. Traverse \n 5. Exit \n");
        scanf("%d",&a);
        switch(a){
        case 1:
            printf("Enter element: \n");
            scanf("%d",&b);
            enqueue(b);
            break;
        case 2:
            dequeue();
            break;
        case 3:
            peek();
            break;
        case 4:
            traverse();
            break;
        case 5:
            flag =1;
            break;
        default:
            printf("ERROR");
            break;
        }}
return 0;}
