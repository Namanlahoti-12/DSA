#include<stdio.h>
int main(){
int a[3][3],b[3][3],i,j;
printf("ENTER MATRIX A");

for(i=0;i<3;i++){
        printf("\n");
    for(j=0;j<3;j++){
        scanf("%d",&a[i][j]);
    }
}
printf("ENTER MATRIX B");
for(i=0;i<3;i++){
        printf("\n");
    for(j=0;j<3;j++){
        scanf("%d",&b[i][j]);
    }
}
int multiply[3][3];
for(int i=0;i<3;i++){
        printf("\n");
    for(int j=0;j<3;j++){
            multiply[i][j]=(a[i][0]*b[0][j])+(a[i][1]*b[1][j])+(a[i][2]*b[2][j]);


    }
}
for(int k=0;k<3;k++){
        printf("\n");
    for(int l=0;l<3;l++){
            printf("%d ",multiply[k][l]);
}
}
return 0;}
