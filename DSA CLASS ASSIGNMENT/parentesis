};
struct stack s;
int isempty(){
    if(s.top==-1){
        return 1;}
    else
        return 0;
    }
int isfull(){
    if(s.top==9){
        return 1;}
    else
        return 0;
    }


int push(a){
    if(isfull()==1){
        printf("Stack is full!!");
    }
    else{
        s.top++;
        s.arr[s.top]=a;
    }
    }
int pop(){
    if(isempty()==1){
        printf("Stack is empty!!");
    }
    else{
        s.top--;
    }}
